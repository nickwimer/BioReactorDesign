FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut.gas;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-8;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    outlet
    {
        type            calculated;
        value           $internalField;
    }
    walls
    {
        type            nutkWallFunction;
        value           $internalField;
    }
    propeller
    {
        type            nutkWallFunction;
        value           $internalField;
    }
}
