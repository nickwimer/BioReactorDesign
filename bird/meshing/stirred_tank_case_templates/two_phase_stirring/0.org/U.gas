FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U.gas;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    // Open to gas in both directions.
    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.gas;
        value           $internalField;
    }
    walls
    {
        type            slip;
    }
    propeller
    {
        type            slip;
    }
}
